# Package the exact executable JAR generated by the successful Maven verify step.
# Avoid a second Maven build or a stale Docker build-layer cache.
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY target/motoservice-lite-1.0.0.jar /app/app.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
